<view class="photo">
  <view style="margin-top: {{marginTop}}px;" class="container">
    <view class="picture">
      <image wx:if="{{photo}}" mode="aspectFit" src="{{photo}}"></image>
    </view>
    <view class="btns">
      <view class="btn" bind:tap="retake">
        <image src="https://meta.kivisense.com/wechat-kivicube-plugin-cases/image2d-tracking/photo/retake.png"></image>
        <text>重拍</text>
      </view>
      <view class="btn" bind:tap="save">
        <image src="https://meta.kivisense.com/wechat-kivicube-plugin-cases/image2d-tracking/photo/save.png"></image>
        <text>保存</text>
      </view>
    </view>
  </view>
</view>
<canvas type="2d" id="canvas"></canvas>
